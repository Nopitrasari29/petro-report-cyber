# App & Environment Configuration
APP_NAME="AI Security Analysis & Reporting Platform"
DEBUG=False

# Database Configuration (PostgreSQL / SQLite)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/petro_report_cyber
# Fallback SQLite untuk pengujian lokal:
# DATABASE_URL=sqlite:///./sql_app.db

# Security & Authentication (JWT)
JWT_SECRET_KEY=change_this_to_a_secure_random_secret_key_in_production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# Local LLM (Ollama Engine)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen3:8b
OLLAMA_TIMEOUT_SECONDS=600
SLA_THRESHOLD_SECONDS=300

# Google OAuth2 Credentials
GOOGLE_CLIENT_ID=

# SMTP Email Configuration (Verifikasi Email & Reset Password)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_FROM_NAME="AI Security Reports"
